Bootstrap: docker
From: nvidia/cuda:11.3.1-cudnn8-devel-ubuntu20.04

%labels
    Author Osmani Dion
    Version v1.0

%environment
    export PATH=/opt/conda/bin:$PATH
    export PYTHONPATH=$PYTHONPATH:/workspace
    # Add CUDA and PyTorch libraries to path
    export LD_LIBRARY_PATH=/opt/conda/envs/text2tex/lib:$LD_LIBRARY_PATH

%files
    # Copy the entire project directory to /workspace
    ./* /workspace/

%post
    export DEBIAN_FRONTEND=noninteractive

    # Install system dependencies
    apt-get update && apt-get install -y \
        wget \
        git \
        libgl1-mesa-glx \
        libglib2.0-0 \
        build-essential \
        python3-dev \
        && rm -rf /var/lib/apt/lists/*

    # Install Miniconda
    mkdir -p /workspace
    cd /tmp
    wget https://repo.anaconda.com/miniconda/Miniconda3-py39_23.3.1-0-Linux-x86_64.sh -O miniconda.sh
    bash miniconda.sh -b -p /opt/conda
    rm miniconda.sh

    # Set up conda
    export PATH=/opt/conda/bin:$PATH
    conda init bash

    # Create Text2Tex environment
    conda create -y -n text2tex python=3.9

    # Make conda activate command available
    echo "source /opt/conda/etc/profile.d/conda.sh" >> /.bashrc

    # Install PyTorch and dependencies - ensure specific versions that work together
    /opt/conda/bin/conda install -y -n text2tex pytorch==1.12.1 torchvision==0.13.1 torchaudio==0.12.1 cudatoolkit=11.3 -c pytorch

    # Install PyTorch3D from specific build for compatibility
    /opt/conda/bin/conda run -n text2tex pip install --no-index --no-cache-dir pytorch3d -f https://dl.fbaipublicfiles.com/pytorch3d/packaging/wheels/py39_cu113_pyt1121/download.html

    # Install other dependencies
    /opt/conda/bin/conda run -n text2tex conda install -y -c fvcore -c iopath -c conda-forge fvcore iopath
    /opt/conda/bin/conda run -n text2tex conda install -y -c bottler nvidiacub
    /opt/conda/bin/conda run -n text2tex conda install -y -c xformers xformers

    # Build mathutils from the correct repository
    cd /tmp
    rm -rf blender-mathutils
    git clone https://gitlab.com/ideasman42/blender-mathutils.git
    cd blender-mathutils

    # Fix the mathutils.c file before building
    sed -i 's/y = _Py_HashDouble(NULL, (double)(array\[i++\]));/y = _Py_HashDouble((double)(array[i++]));/' src/mathutils/mathutils.c

    # Now build and install
    /opt/conda/bin/conda run -n text2tex python setup.py install

    # Install requirements
    cd /workspace
    /opt/conda/bin/conda run -n text2tex pip install -r requirements.txt

    # Create directories for models if they don't exist
    mkdir -p /workspace/models/ControlNet/models/

    # Download ControlNet model if it doesn't exist
    if [ ! -f /workspace/models/ControlNet/models/control_sd15_depth.pth ]; then
        wget -O /workspace/models/ControlNet/models/control_sd15_depth.pth https://huggingface.co/lllyasviel/ControlNet/resolve/main/models/control_sd15_depth.pth
    fi

    # Create output directory if it doesn't exist
    mkdir -p /workspace/outputs/backpack

    # Make workspace directory and add permissions
    chmod -R 777 /workspace

%runscript
    source /opt/conda/etc/profile.d/conda.sh
    conda activate text2tex
    cd /workspace
    exec "$@"

%startscript
    source /opt/conda/etc/profile.d/conda.sh
    conda activate text2tex
    cd /workspace
    exec python /workspace/scripts/generate_texture.py "$@"
